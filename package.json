{
  "name": "unspsc-mapper",
  "version": "1.0.0",
  "private": true,
  "description": "Auto-categorize procurement spend into 8-digit UNSPSC codes using supplier enrichment plus LLM classification, with parent/subsidiary mapping, human review, live supplier sync, and CSV/PDF reporting. Runs on Neon, Render and Vercel free tiers.",
  "license": "MIT",
  "author": "UNSPSC Spend Categorizer contributors",
  "keywords": [
    "unspsc",
    "spend-analysis",
    "procurement",
    "spend-categorization",
    "supplier-classification",
    "parent-subsidiary",
    "llm",
    "groq",
    "nextjs",
    "drizzle-orm",
    "neon",
    "postgres"
  ],
  "homepage": "https://github.com/olenny-coder/unspsc-mapper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olenny-coder/unspsc-mapper.git"
  },
  "bugs": {
    "url": "https://github.com/olenny-coder/unspsc-mapper/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-unspsc.ts",
    "db:seed:sample": "tsx scripts/seed-sample-suppliers.ts",
    "db:seed:demo": "tsx scripts/seed-demo-classifications.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:start": "node --import tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once=full",
    "worker:ping": "node scripts/ping-worker.mjs",
    "assets:generate": "node scripts/generate-icons.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^8.1.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
