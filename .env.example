# ---------------------------------------------------------------------------
# Database (Neon Postgres). Pooled connection string for the app/worker.
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unspsc"

# Optional: direct (non-pooled) Neon URL, used by drizzle-kit for migrations.
# Falls back to DATABASE_URL when empty.
DATABASE_URL_UNPOOLED=""

# ---------------------------------------------------------------------------
# Groq (free tier). https://console.groq.com/keys
# 70B: 1,000 req/day   |   8B: 14,400 req/day
#
# THIS is where your Groq API key goes: set GROQ_API_KEY here for local
# development, and in the Vercel + Render environment variables for deployments.
# Verify it took effect at GET /api/health -> checks[name=groq].ok === true.
# ---------------------------------------------------------------------------
GROQ_API_KEY="gsk_your_key_here"
GROQ_MODEL_ACCURATE="llama-3.3-70b-versatile"
GROQ_MODEL_BULK="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# ---------------------------------------------------------------------------
# Enrichment provider.
#
#   companyenrich | contextdev | brightdata | none
#
# companyenrich and contextdev give 500 free credits. Bright Data is a paid
# platform: the Scraper API has trial credit then bills per record (from about
# $0.75/1k), so set ENRICH_MONTHLY_CREDIT_LIMIT to a number you actually mean.
#
# Bright Data is keyed by *dataset* and by *URL*, so it also needs
# ENRICH_DATASET_ID, and a supplier must have a domain. Run
#   npm run brightdata:probe -- --domain dell.com --name "Dell Technologies"
# to see exactly what your dataset returns before enriching a real batch.
#
# Leave ENRICH_PROVIDER="none" to run in LLM-only mode.
# ---------------------------------------------------------------------------
ENRICH_PROVIDER="companyenrich"
ENRICH_API_KEY=""
ENRICH_BASE_URL=""
ENRICH_MONTHLY_CREDIT_LIMIT="500"

# Bright Data only. The dataset id is on the dataset's page in the Control Panel;
# the API key is at https://brightdata.com/cp/setting/users.
ENRICH_DATASET_ID=""

# Bright Data only, optional. A dataset's input is the URL of the site it scrapes,
# not the supplier's own website, so a LinkedIn company dataset needs the profile
# path rather than https://<domain>. Placeholders: {domain} {slug} {name}
#   ENRICH_INPUT_URL_TEMPLATE="https://www.linkedin.com/company/{slug}"
ENRICH_INPUT_URL_TEMPLATE=""

# ---------------------------------------------------------------------------
# Authentication
#
# The dashboard and EVERY mutating endpoint (upload, enrich, classify, settings,
# hierarchy edits) require one of:
#   * Authorization: Bearer <DASHBOARD_SECRET>   (scripts, curl, cron), or
#   * the signed session cookie set by the /login page.
#
# In production, if neither DASHBOARD_SECRET nor WORKER_SECRET is set, those
# endpoints are DISABLED (503) rather than left open.
# ---------------------------------------------------------------------------

# Shared secret for the dashboard + mutating API. Falls back to WORKER_SECRET.
DASHBOARD_SECRET="change-me-to-a-long-random-string"

# Set to "false" to require auth even in development. Ignored in production.
ALLOW_UNAUTHENTICATED_DEV="true"

# ---------------------------------------------------------------------------
# Worker / cron authentication
# ---------------------------------------------------------------------------
WORKER_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of additional secrets accepted by /api/sync and
# /api/reports/generate (e.g. a rotation window). Optional.
WORKER_SECRET_ALLOWLIST=""
# Shared secret required by the Render worker's own /run and /health endpoints.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Public origin (SEO: canonical URLs, sitemap, Open Graph)
#
# Must be absolute. A missing scheme is tolerated (assumed http://); a malformed
# value fails the build naming the variable. Resolution order:
#
#   1. SITE_URL                              <- set this for a custom domain
#   2. VERCEL_PROJECT_PRODUCTION_URL         <- Vercel supplies it automatically
#   3. APP_ORIGIN                            <- set this on other hosts
#   4. NEXT_PUBLIC_APP_URL                   <- legacy fallback
#   5. http://localhost:3000
#
# On Vercel you can leave all of them unset and it will just work.
#
# Why APP_ORIGIN exists: Next.js replaces every NEXT_PUBLIC_* reference with the
# value present at BUILD time, so NEXT_PUBLIC_APP_URL cannot be read reliably at
# runtime. APP_ORIGIN is a plain server-side variable with no such caveat.
# ---------------------------------------------------------------------------
SITE_URL=""

# Local development origin. Ignored when SITE_URL or the Vercel host is set.
APP_ORIGIN="http://localhost:3000"

# Legacy: still honoured as a fallback, but prefer SITE_URL / APP_ORIGIN above.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Whether search engines may index this deployment.
#
# Defaults to false ON PURPOSE. The dashboard renders supplier names, spend
# totals and corporate structure behind authentication; letting that be indexed
# would leak commercially sensitive data through search results and cached
# snippets. Set to true only for a public demo deployment — and even then the
# API and all data-bearing pages stay blocked in robots.txt.
ALLOW_INDEXING="false"

# ---------------------------------------------------------------------------
# Public read-only demo.
# ---------------------------------------------------------------------------
#
# When true, an anonymous visitor is served the whole UI from a bundled
# illustrative dataset (`lib/demo/`) instead of the database, and every mutating
# endpoint refuses them with 403 `demo_read_only`. Nobody can upload, classify,
# enrich, sync, correct a code or change a setting without signing in.
#
# Off by default, and safe to enable on a deployment holding real data: the demo
# path never reaches a query or a route handler, so it cannot read your suppliers
# — it simply stops serving them to anyone who has not authenticated. Only a
# request carrying NO credential is treated as a demo visitor; a failed or expired
# sign-in still returns 401 so nobody is shown sample data believing it is real.
#
# Pair it with ALLOW_INDEXING only if you want the demo to be searchable.
DEMO_MODE="false"

# Used as the `actor` on audit rows written by the dashboard.
APP_ACTOR="dashboard"
# Comma-separated emails allowed into /settings. Empty = open (single-tenant demo).
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Sync / classification tuning
#
# NOTE ON UNITS — a wrong unit here fails the build with a readable message
# (e.g. `CLASSIFY_CONFIDENCE_THRESHOLD: expected 0..1, received "70"`), so read
# these carefully:
#
#   CLASSIFY_CONFIDENCE_THRESHOLD  a probability 0..1, NOT a percentage.
#                                  Use 0.7 — not 70.
#   *_DAYS, *_SIZE, *_LIMIT        plain integers, no units.
#                                  Use 30 — not "30 days".
#   LLM_BATCH_SIZE                 1..10 (10 suppliers per Groq request).
# ---------------------------------------------------------------------------
SYNC_STALE_DAYS="30"
SYNC_BATCH_SIZE="25"
SYNC_MAX_BATCHES_PER_RUN="12"
CLASSIFY_CONFIDENCE_THRESHOLD="0.7"
CLASSIFY_MODEL_STRATEGY="tiered"
LLM_BATCH_SIZE="10"
LLM_MAX_REQUESTS_PER_MINUTE="25"
LLM_MAX_REQUESTS_PER_DAY_70B="1000"
LLM_MAX_REQUESTS_PER_DAY_8B="14400"
LLM_DAILY_BUDGET_RESERVE="50"
ENRICH_CONCURRENCY="3"

# ---------------------------------------------------------------------------
# Worker HTTP server (Render)
# ---------------------------------------------------------------------------
PORT="10000"
# Cron expressions (node-cron syntax) handled by the worker scheduler.
CRON_SYNC="0 3 * * *"
CRON_REPORT="0 6 * * 1"
WEEKLY_REPORT_ENABLED="true"
SAMPLE_CSV_PATH="samples/suppliers.csv"

# ---------------------------------------------------------------------------
# Optional: path to an authoritative UNSPSC CSV used by `npm run db:seed`
# Columns: code,segment,family,class,commodity,description
# ---------------------------------------------------------------------------
UNSPSC_SEED_CSV=""
